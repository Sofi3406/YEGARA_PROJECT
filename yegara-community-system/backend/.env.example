# Backend environment variables example
# Copy to .env and adjust values before running

# Server
PORT=5000

# MongoDB connection
MONGO_URI=mongodb://localhost:27017/yegara

# JWT secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Public rate limiter defaults (milliseconds and max requests)
# window in milliseconds (e.g., 60000 = 1 minute)
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
# max requests per window per IP
PUBLIC_RATE_LIMIT_MAX=30

# You can override per-route when creating limiters in code
